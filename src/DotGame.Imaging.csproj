<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
    </PropertyGroup>

    <PropertyGroup>
        <Version>2.0.1</Version>
        <Description>PNG, JPEG and WebP image codecs for .NET, with no dependencies. Trim and AOT safe.</Description>
        <Authors>Hot Chai Games LLC</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>png;jpeg;webp;image;codec;decoder;encoder</PackageTags>
        <RepositoryUrl>https://github.com/hotchaipro/DotGame.Imaging</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="" />
        <None Include="..\README.md" Pack="true" PackagePath="" />
        <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DotGame.Imaging.Tests" />
    </ItemGroup>

    <!--
        The public API baseline: PublicAPI.Shipped.txt lists what released packages have, and
        PublicAPI.Unshipped.txt what's changed since. A public API that isn't in them, or is in them but
        gone, fails the build (RS0016, RS0017), so every change to the API is a change to these files too.
        At a release, move Unshipped's lines into Shipped.
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
        <AdditionalFiles Include="..\eng\api\DotGame.Imaging\PublicAPI.Shipped.txt" Visible="false" />
        <AdditionalFiles Include="..\eng\api\DotGame.Imaging\PublicAPI.Unshipped.txt" Visible="false" />
    </ItemGroup>

</Project>
