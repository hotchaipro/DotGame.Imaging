<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- For IDE0005 (unneeded usings), which needs it; the tests don't need doc comments (CS1591) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Test names separate the member and the case with underscores (Decode_ReadsEveryFormat) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\DotGame.Imaging.csproj" />
  </ItemGroup>

</Project>
